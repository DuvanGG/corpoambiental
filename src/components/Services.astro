---
const services = [
  {
    title: "Recolección",
    description:
      "A través de nuestros canales de atención contamos con 5 Macrorutas ubicadas en las localidades de Norte Centro Histórico, Metropolitana, Sur Oriente, Sur occidente, Riomar a través de nuestros canales nuestros usuarios pueden solicitar la recolección de los residuos garantizamos rutas efectivas y confiables.",
    link: "#",
    badge: "5 Macrorutas",
    // Ícono de ruta / recolección
    icon: `<svg class="h-6 w-6 text-[#567E3E]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>`
  },
  {
    title: "Clasificación",
    description:
      "Contamos con personal capacitado en la clasificación de materiales aprovechables y certificados por el SENA en la norma de competencia laboral (Recolectar residuos sólidos según procedimiento de aprovechamiento y normativa ambiental).",
    link: "#",
    badge: "Personal SENA",
    // Ícono de personal / clasificación capacitada
    icon: `<svg class="h-6 w-6 text-[#567E3E]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>`
  },
  {
    title: "Transporte",
    description:
      "Contamos con vehículos que cumplen los requisitos necesarios para prestar un servicio de transporte teniendo en cuenta el volumen de material reciclable a recuperar, cumpliendo así parámetros normativos establecidos para el traslado de los residuos a nuestros centros de acopio.",
    link: "#",
    badge: "Flota Cumplida",
    // Ícono de vehículo / logística
    icon: `<svg class="h-6 w-6 text-[#567E3E]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>`
  },
  {
    title: "Certificación de disposición final",
    description:
      "Contamos con la legitimidad para emitir certificados de disposición final garantizando la entrega de materiales aprovechables a cualquiera de nuestros centros de acopio.",
    link: "#",
    badge: "Garantía Legal",
    // Ícono de documento certificado / sello
    icon: `<svg class="h-6 w-6 text-[#567E3E]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>`
  },
];
---

<section id="servicios" class="bg-slate-50 py-8 scroll-mt-10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Servicios
      </h2>
      <!-- <p class="mt-4 text-base leading-7 text-slate-600">
        Unimos ingeniería de punta con conciencia ambiental para ofrecer
        servicios integrales de gestión de residuos.
      </p> -->
    </div>

    <div class="mt-12 grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service) => (
          <article class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg flex flex-col justify-between">
            <div>
              <!-- Contenedor del Ícono -->
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-[#F3F7F0] border border-[#D2E0C9] group-hover:bg-[#567E3E] transition-colors duration-300 mb-4">
                <Fragment set:html={service.icon} />
              </div>

              <h3 class="text-xl font-semibold text-slate-900 group-hover:text-[#385229] transition-colors">
                {service.title}
              </h3>

              <p class="mt-3 text-sm leading-6 text-slate-600">
                {service.description}
              </p>
            </div>

            <!-- Etiqueta / Badge Inferior -->
            <div class="pt-6 mt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs font-semibold text-[#385229] bg-[#F3F7F0] border border-[#D2E0C9] px-3 py-1 rounded-full">
                {service.badge}
              </span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Modifica dinámicamente el color del icono SVG a blanco cuando la tarjeta recibe hover */
  .group:hover :global(svg) {
    stroke: #ffffff;
  }
</style>