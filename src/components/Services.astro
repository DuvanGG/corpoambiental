---
const services = [
  {
    title: "Recolección eficiente",
    description:
      "Logística optimizada para recoger residuos de forma rápida y segura.",
    link: "#",
  },
  {
    title: "Procesamiento eco-amigable",
    description:
      "Transformamos materiales con procesos responsables y sostenibles.",
    link: "#",
  },
  {
    title: "Consultoría en sostenibilidad",
    description:
      "Te ayudamos a mejorar tus procesos y a reducir tu impacto ambiental.",
    link: "#",
  },
];
---

<section id="servicios" class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Soluciones que regeneran
      </h2>
      <p class="mt-4 text-base leading-7 text-slate-600">
        Unimos ingeniería de punta con conciencia ambiental para ofrecer
        servicios integrales de gestión de residuos.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <article class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
            <h3 class="text-xl font-semibold text-slate-900">
              {service.title}
            </h3>

            <p class="mt-3 text-sm leading-6 text-slate-600">
              {service.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
