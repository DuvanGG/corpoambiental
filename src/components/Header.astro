---
const nav = [
  { label: "Inicio", href: "#inicio", active: true },
  { label: "Servicios", href: "#servicios" },
  { label: "Impacto", href: "#impacto" },
  { label: "Contacto", href: "#contacto" },
];

const whatsappNumber = "573001112233";
const whatsappMessage = encodeURIComponent(
  "Hola, quiero recibir más información sobre sus servicios.",
);
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<header
  class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-100"
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <a href="#inicio" class="flex items-center gap-3">
      <img src="/assets/logo.svg" alt="corambiental" class="h-8 w-auto" />
    </a>

    <nav
      class="hidden md:flex items-center gap-8"
      aria-label="Navegación principal"
    >
      <ul class="flex items-center gap-6">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class={`text-sm font-medium transition ${
                  item.active
                    ? "text-[var(--color-brand)] underline decoration-2 underline-offset-4"
                    : "text-slate-700 hover:text-[var(--color-brand)]"
                }`}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex items-center rounded-full bg-cyan-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-cyan-600"
        aria-label="Contactar por WhatsApp"
      >
        WhatsApp
      </a>

      <button
        class="md:hidden inline-flex items-center justify-center rounded-md p-2 text-slate-700 hover:bg-slate-100"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-button"
      >
        <span class="sr-only">Abrir menú</span>
        <svg
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-slate-100 bg-white"
  >
    <nav class="px-4 py-3" aria-label="Navegación móvil">
      <div class="flex flex-col gap-1">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="rounded-md px-3 py-2 text-base font-medium text-slate-700 hover:bg-slate-50 hover:text-[var(--color-brand)]"
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 block rounded-full bg-cyan-500 px-4 py-2 text-center font-semibold text-white transition hover:bg-cyan-600"
      >
        WhatsApp
      </a>
    </nav>
  </div>

  <script type="module">
    const btn = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");

    if (btn && menu) {
      btn.addEventListener("click", () => {
        const expanded = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!expanded));
        menu.classList.toggle("hidden");
      });
    }
  </script>
</header>
