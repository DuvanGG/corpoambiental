---
import logo from "../assets/logo-header.svg";

const nav = [
  { label: "Inicio", href: "#inicio", id: "inicio" },
  { label: "Equipo", href: "#Equipo", id: "Equipo" },
  { label: "Nosotros", href: "#nosotros", id: "nosotros" },
  { label: "Fondo Solidario", href: "#fondo-solidario", id: "fondo-solidario" },
  { label: "Rutas", href: "#rutas", id: "rutas" },
  { label: "Servicios", href: "#servicios", id: "servicios" },
  { label: "Contacto", href: "#contacto", id: "contacto" },
];

const whatsappNumber = "573182406639";
const whatsappMessage = encodeURIComponent(
  "Hola, quiero recibir más información sobre sus servicios.",
);
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<header
  class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-100"
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <a href="#inicio" class="flex items-center gap-3">
      <img src={logo.src} alt="corpoambiental" class="h-10 w-auto" />
    </a>

    <nav
      class="hidden md:flex items-center gap-8"
      aria-label="Navegación principal"
    >
      <ul class="flex items-center gap-6">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                data-section={item.id}
                class="nav-link text-sm font-medium text-slate-700 transition hover:text-[var(--color-brand)]"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex items-center rounded-full bg-[#567E3E] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#476933]"
        aria-label="Contactar por WhatsApp"
      >
        Contactanos&nbsp;
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
          ></path>
        </svg>
      </a>

      <button
        class="md:hidden inline-flex items-center justify-center rounded-md p-2 text-slate-700 hover:bg-slate-100"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-button"
      >
        <span class="sr-only">Abrir menú</span>
        <svg
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-slate-100 bg-white"
  >
    <nav class="px-4 py-3" aria-label="Navegación móvil">
      <div class="flex flex-col gap-1">
        {
          nav.map((item) => (
            <a
              href={item.href}
              data-section={item.id}
              class="nav-link-mobile rounded-md px-3 py-2 text-base font-medium text-slate-700 hover:bg-slate-50 hover:text-[var(--color-brand)]"
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 flex items-center justify-center gap-2 rounded-full bg-[#567E3E] px-4 py-2 text-center text-sm font-semibold text-white transition hover:bg-[#476933]"
        aria-label="Contactar por WhatsApp"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
          ></path>
        </svg>
        <span>Contactanos</span>
      </a>
    </nav>
  </div>

  <script type="module">
    const btn = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    const links = document.querySelectorAll(".nav-link, .nav-link-mobile");
    const sections = document.querySelectorAll("section[id]");

    if (btn && menu) {
      btn.addEventListener("click", () => {
        const expanded = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!expanded));
        menu.classList.toggle("hidden");
      });
    }

    const setActive = (id) => {
      links.forEach((link) => {
        const isActive = link.getAttribute("data-section") === id;
        link.classList.toggle("text-[var(--color-brand)]", isActive);
        link.classList.toggle("underline", isActive);
        link.classList.toggle("underline-offset-4", isActive);
        link.classList.toggle("decoration-2", isActive);
        link.classList.toggle("font-semibold", isActive);
        link.classList.toggle("text-slate-700", !isActive);
      });
    };

    const sectionRatios = new Map();

    const updateActive = () => {
      let bestId = null;
      let bestRatio = 0;

      sectionRatios.forEach((ratio, id) => {
        if (ratio > bestRatio) {
          bestRatio = ratio;
          bestId = id;
        }
      });

      setActive(bestId);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          sectionRatios.set(
            entry.target.id,
            entry.isIntersecting ? entry.intersectionRatio : 0,
          );
        });
        updateActive();
      },
      {
        threshold: [0.05, 0.1, 0.2, 0.35, 0.5, 0.65, 0.8, 0.95, 1],
        rootMargin: "-80px 0px -45% 0px",
      },
    );

    sections.forEach((section) => observer.observe(section));

    const updateStartSection = () => {
      if (window.scrollY < 150) {
        setActive("inicio");
      }
    };

    window.addEventListener("scroll", updateStartSection, { passive: true });
    updateStartSection();
  </script>
</header>
