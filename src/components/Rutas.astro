---
const rutas = [
  {
    title: "Ruta Norte",
    zone: "Zona Industrial",
    status: "En progreso",
    statusClass: "bg-[#E4EDE0] text-[#385229]",
    description:
      "Ruta activa de recolección en la zona industrial y sus alrededores.",
    start: "Bodega Norte",
    end: "Centro de acopio",
    distance: "12.8 km",
    time: "2 h 30 min",
    color: "#567E3E",
    path: "M100 300C200 300 250 100 400 100C550 100 600 250 700 250",
  },
  {
    title: "Ruta Centro",
    zone: "Casco Urbano",
    status: "Completada",
    statusClass: "bg-slate-100 text-slate-600",
    description:
      "Recorrido completado por los principales sectores del casco urbano.",
    start: "Parque central",
    end: "Centro de acopio",
    distance: "8.4 km",
    time: "1 h 45 min",
    color: "#83B665",
    path: "M150 100C300 100 350 350 500 350C650 350 750 200 750 150",
  },
  {
    title: "Ruta Industrial",
    zone: "Parque Logístico",
    status: "En progreso",
    statusClass: "bg-[#E4EDE0] text-[#385229]",
    description:
      "Ruta enfocada en la recolección de materiales en parques logísticos.",
    start: "Parque logístico",
    end: "Planta de clasificación",
    distance: "16.2 km",
    time: "3 h 10 min",
    color: "#385229",
    path: "M100 250C180 80 320 80 400 250C480 420 620 420 720 150",
  },
];
---

<section id="rutas" class="scroll-mt-20 bg-[#F3F7F0] py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Encabezado -->
    <div class="mx-auto mb-16 max-w-2xl space-y-4 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Nuestras Rutas de Reciclaje
      </h2>

      <p class="text-base leading-7 text-slate-600">
        Optimizamos cada trayecto mediante algoritmos de IA para reducir la
        huella de carbono y maximizar la eficiencia en la recolección de
        materiales.
      </p>
    </div>

    <!-- Carrusel -->
    <div
      id="routes-carousel"
      class="relative overflow-hidden rounded-[2rem] border border-[#D2E0C9]/40 bg-white shadow-sm"
    >
      {
        rutas.map((ruta, index) => (
          <article
            class:list={[
              "route-slide",
              "grid",
              "items-stretch",
              "gap-8",
              "p-4",
              "md:grid-cols-12",
              "md:p-8",
              index === 0 && "is-active",
            ]}
            data-slide={index}
            aria-hidden={index === 0 ? "false" : "true"}
          >
            <!-- Mapa de la ruta -->
            <div class="relative min-h-[400px] overflow-hidden rounded-[1.5rem] border border-[#D2E0C9]/40 bg-[#F8FAF6] md:col-span-8">
              <div class="absolute inset-0 opacity-20">
                <div class="absolute inset-0 bg-[radial-gradient(#567E3E_1px,transparent_1px)] [background-size:24px_24px]"></div>
              </div>

              <div class="relative flex h-full w-full items-center justify-center p-8">
                <svg
                  class="h-full max-h-[300px] w-full"
                  fill="none"
                  viewBox="0 0 800 400"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-label={`Mapa visual de ${ruta.title}`}
                  role="img"
                >
                  <!-- Ruta principal -->
                  <path
                    d={ruta.path}
                    stroke={ruta.color}
                    stroke-dasharray="8 8"
                    stroke-linecap="round"
                    stroke-width="5"
                    class="route-path"
                  />

                  <!-- Inicio -->
                  <circle
                    cx="100"
                    cy="250"
                    fill={ruta.color}
                    r="9"
                  />

                  <text
                    x="85"
                    y="225"
                    fill="#1a1c1e"
                    font-family="Inter"
                    font-size="14"
                    font-weight="600"
                  >
                    Inicio
                  </text>

                  <!-- Fin -->
                  <circle
                    cx="720"
                    cy="150"
                    fill="#83B665"
                    r="9"
                  />

                  <text
                    x="705"
                    y="125"
                    fill="#1a1c1e"
                    font-family="Inter"
                    font-size="14"
                    font-weight="600"
                  >
                    Fin
                  </text>
                </svg>

                <!-- Indicador -->
                <div class="absolute left-6 top-6 flex items-center gap-2 rounded-full border border-[#567E3E]/10 bg-white/80 px-4 py-2 backdrop-blur-md">
                  <span
                    class="h-2 w-2 animate-pulse rounded-full bg-[#567E3E]"
                  ></span>

                  <span class="text-xs font-semibold text-[#567E3E]">
                    Monitoreo en Vivo
                  </span>
                </div>

                <!-- Nombre de la ruta sobre el mapa -->
                <div class="absolute bottom-6 left-6 rounded-xl bg-white/85 px-4 py-3 shadow-sm backdrop-blur-md">
                  <p class="text-sm font-bold text-slate-900">
                    {ruta.title}
                  </p>

                  <p class="text-xs text-slate-500">
                    {ruta.zone}
                  </p>
                </div>
              </div>
            </div>

            <!-- Información de la ruta -->
            <div class="flex flex-col justify-between rounded-[1.5rem] border border-[#D2E0C9]/30 bg-white p-6 md:col-span-4">
              <div>
                <div class="mb-5 flex items-start justify-between gap-4">
                  <div>
                    <p class="mb-1 text-sm font-medium text-[#567E3E]">
                      Ruta de reciclaje
                    </p>

                    <h3 class="text-2xl font-bold text-slate-900">
                      {ruta.title}
                    </h3>
                  </div>

                  <span
                    class={`shrink-0 rounded-full px-3 py-1 text-xs font-semibold ${ruta.statusClass}`}
                  >
                    {ruta.status}
                  </span>
                </div>

                <p class="mb-8 text-sm leading-6 text-slate-600">
                  {ruta.description}
                </p>

                <div class="space-y-4">
                  <div class="rounded-xl bg-[#F3F7F0] p-4">
                    <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
                      Punto de inicio
                    </p>

                    <p class="mt-1 text-sm font-semibold text-slate-900">
                      {ruta.start}
                    </p>
                  </div>

                  <div class="rounded-xl bg-[#F3F7F0] p-4">
                    <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
                      Punto final
                    </p>

                    <p class="mt-1 text-sm font-semibold text-slate-900">
                      {ruta.end}
                    </p>
                  </div>
                </div>
              </div>

              <div class="mt-8 grid grid-cols-2 gap-3">
                <div class="rounded-xl border border-slate-100 p-4">
                  <p class="text-xs text-slate-500">Distancia</p>
                  <p class="mt-1 text-lg font-bold text-[#385229]">
                    {ruta.distance}
                  </p>
                </div>

                <div class="rounded-xl border border-slate-100 p-4">
                  <p class="text-xs text-slate-500">Duración</p>
                  <p class="mt-1 text-lg font-bold text-[#385229]">
                    {ruta.time}
                  </p>
                </div>
              </div>
            </div>
          </article>
        ))
      }

      <!-- Botón anterior -->
      <button
        id="route-prev"
        type="button"
        class="route-control route-control--prev"
        aria-label="Ver ruta anterior"
      >
        &#10094;
      </button>

      <!-- Botón siguiente -->
      <button
        id="route-next"
        type="button"
        class="route-control route-control--next"
        aria-label="Ver ruta siguiente"
      >
        &#10095;
      </button>

      <!-- Indicadores -->
      <div class="route-dots" aria-label="Seleccionar ruta">
        {
          rutas.map((ruta, index) => (
            <button
              type="button"
              class:list={["route-dot", index === 0 && "is-active"]}
              data-dot={index}
              aria-label={`Mostrar ${ruta.title}`}
              aria-current={index === 0 ? "true" : "false"}
            ></button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .route-slide {
    display: none;
    animation: route-fade 0.35s ease;
  }

  .route-slide.is-active {
    display: grid;
  }

  @keyframes route-fade {
    from {
      opacity: 0;
      transform: translateX(12px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .route-path {
    animation: route-dash 2s linear infinite;
  }

  @keyframes route-dash {
    to {
      stroke-dashoffset: -32;
    }
  }

  .route-control {
    position: absolute;
    top: 50%;
    z-index: 10;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 0;
    border-radius: 999px;
    color: #385229;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 4px 14px rgba(56, 82, 41, 0.15);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .route-control:hover {
    background: #e4ede0;
    transform: translateY(-50%) scale(1.08);
  }

  .route-control:focus-visible,
  .route-dot:focus-visible {
    outline: 3px solid #83b665;
    outline-offset: 3px;
  }

  .route-control--prev {
    left: 20px;
  }

  .route-control--next {
    right: 20px;
  }

  .route-dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    z-index: 10;
    display: flex;
    gap: 8px;
    transform: translateX(-50%);
  }

  .route-dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #cbd5c4;
    cursor: pointer;
    transition:
      width 0.2s ease,
      background 0.2s ease;
  }

  .route-dot.is-active {
    width: 26px;
    background: #567e3e;
  }

  @media (max-width: 640px) {
    .route-control {
      top: 215px;
      width: 36px;
      height: 36px;
    }

    .route-control--prev {
      left: 10px;
    }

    .route-control--next {
      right: 10px;
    }

    .route-dots {
      bottom: 14px;
    }
  }
</style>

<script>
  const slides = Array.from(
    document.querySelectorAll(".route-slide")
  );

  const dots = Array.from(
    document.querySelectorAll(".route-dot")
  );

  const previousButton = document.querySelector("#route-prev");
  const nextButton = document.querySelector("#route-next");

  let currentSlide = 0;

  function showSlide(index) {
    if (!slides.length) return;

    currentSlide = (index + slides.length) % slides.length;

    slides.forEach((slide, slideIndex) => {
      const isActive = slideIndex === currentSlide;

      slide.classList.toggle("is-active", isActive);
      slide.setAttribute("aria-hidden", String(!isActive));
    });

    dots.forEach((dot, dotIndex) => {
      const isActive = dotIndex === currentSlide;

      dot.classList.toggle("is-active", isActive);
      dot.setAttribute("aria-current", isActive ? "true" : "false");
    });
  }

  function showPreviousSlide() {
    showSlide(currentSlide - 1);
  }

  function showNextSlide() {
    showSlide(currentSlide + 1);
  }

  previousButton?.addEventListener("click", showPreviousSlide);
  nextButton?.addEventListener("click", showNextSlide);

  dots.forEach((dot, index) => {
    dot.addEventListener("click", () => {
      showSlide(index);
    });
  });

  document.addEventListener("keydown", (event) => {
    const routesSection = document.querySelector("#rutas");

    if (!routesSection) return;

    const sectionIsVisible =
      routesSection.getBoundingClientRect().top < window.innerHeight &&
      routesSection.getBoundingClientRect().bottom > 0;

    if (!sectionIsVisible) return;

    if (event.key === "ArrowLeft") {
      showPreviousSlide();
    }

    if (event.key === "ArrowRight") {
      showNextSlide();
    }
  });
</script>