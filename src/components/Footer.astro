---
import logo from "../assets/logo-footer.svg";

const year = new Date().getFullYear();

const quickLinks = [
  { label: "Inicio", href: "#inicio" },
  { label: "Equipo", href: "#Equipo", id: "Equipo" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Fondo Solidario", href: "#fondo-solidario" },
  { label: "Servicios", href: "#servicios" },
  { label: "Contacto", href: "#contacto" },
];

const whatsappNumber = "573182406639";
const whatsappMessage = encodeURIComponent(
  "Hola, quiero recibir más información sobre sus servicios.",
);
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<footer class="bg-slate-950 text-slate-200">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <!--<a href="#inicio" class="inline-flex items-center gap-3">
          <img src={logo.src} alt="corpoambiental" class="h-8 w-auto" />
        </a>-->
        <h3 class="text-sm font-semibold tracking-[0.2em] text-white">
          Corporación ambiental de recicladores de la costa CORPOAMBIENTALES
        </h3>
        <p class="max-w-sm text-sm leading-6 text-slate-400">
          Impulsamos soluciones sostenibles para transformar residuos en valor y
          construir un futuro más responsable.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold tracking-[0.2em] text-white">
          Enlaces
        </h3>

        <ul class="mt-4 space-y-3 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-slate-400 transition hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold tracking-[0.2em] text-white">
          Contacto
        </h3>

        <ul class="mt-4 space-y-3 text-sm text-slate-400">
          <li>
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="transition hover:text-white"
            >
              WhatsApp
            </a>
          </li>
          <li>
            <a
              href="mailto:corpoambiencosta@gmail.com"
              class="transition hover:text-white"
            >
              corpoambiencosta@gmail.com
            </a>
          </li>
          <li>
            <a
              href="https://www.google.com/maps/search/?api=1&query=Cra+24+%23+110-41%2C+Barrio+Los+Olivos+II%2C+Barranquilla%2C+Colombia"
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-[#385229]"
            >
              Cra 24 # 110-41, Barrio Los Olivos II - Barranquilla, Colombia
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold tracking-[0.2em] text-white">
          Horario
        </h3>

        <ul class="mt-4 space-y-3 text-sm text-slate-400">
          <li>Lunes a viernes: 8:00 a. m. - 5:00 p. m.</li>
          <li>Sábados: 8:00 a. m. - 3:00 p. m.</li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 border-t border-white/10 pt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm text-slate-500">
        © {year} Corpoambiental. Todos los derechos reservados.
      </p>

      <div class="flex gap-4 text-sm text-slate-500">
        <a href="#" class="transition hover:text-white">Términos</a>
        <a href="#" class="transition hover:text-white">Privacidad</a>
      </div>
    </div>
  </div>
</footer>
