---
const whatsappNumber = "573001112233";
const whatsappMessage = encodeURIComponent(
  "Hola, quiero más información sobre sus servicios.",
);
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<section id="inicio" class="bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 py-16 md:grid-cols-2 md:py-24">
      <div class="space-y-8">
        <div class="flex flex-wrap gap-2">
          <span
            class="inline-flex items-center rounded-full border border-cyan-200 bg-cyan-50 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-cyan-700"
          >
            Sostenibilidad
          </span>

          <span
            class="inline-flex items-center rounded-full border border-cyan-200 bg-cyan-50 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-cyan-700"
          >
            Reciclaje
          </span>

          <span
            class="inline-flex items-center rounded-full border border-cyan-200 bg-cyan-50 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-cyan-700"
          >
            Economía circular
          </span>
        </div>

        <div class="space-y-5">
          <h1
            class="max-w-xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl"
          >
            Transformamos el futuro a través del
            <span class="text-[var(--color-brand)]">
              reciclaje inteligente</span
            >
          </h1>

          <p class="max-w-lg text-base leading-7 text-slate-600 sm:text-lg">
            Impulsamos la economía circular mediante tecnología de vanguardia y
            procesos eficientes que cuidan el planeta mientras optimizan tus
            recursos.
          </p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-xl bg-cyan-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-cyan-500/20 transition hover:bg-cyan-600"
            aria-label="Contactar por WhatsApp"
          >
            Empezar ahora
            <span class="ml-2">→</span>
          </a>

          <a
            href="#impacto"
            class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
          >
            Ver impacto
          </a>
        </div>
      </div>

      <div class="relative">
        <div
          class="overflow-hidden rounded-[2rem] bg-slate-100 shadow-2xl shadow-slate-200"
        >
          <img
            src="/images/foto01.jpeg" 
            alt="Equipo corpoambiental"
            class="h-[320px] w-full object-cover sm:h-[420px]"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <div
          class="absolute bottom-4 left-4 right-4 rounded-2xl border border-white/70 bg-white/80 p-4 shadow-lg backdrop-blur-md"
        >
          <div class="flex items-center justify-between gap-4">
            <div>
              <p
                class="text-xs font-medium uppercase tracking-[0.2em] text-slate-500"
              >
                Nuestro equipo
              </p>
              <p class="mt-1 text-sm font-semibold text-slate-900">
                Transformando vidas
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
